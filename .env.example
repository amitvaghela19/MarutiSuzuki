# Optional — app runs without these keys using cache + free APIs
# API port (default 8000). Use 8010 if Windows reports WinError 10013 on 8000.
# UI port: set VITE_PORT=5174 in the shell before .\tasks.ps1 frontend
API_PORT=8000
FRED_API_KEY=
NEWSDATA_API_KEY=
ENABLE_HF_CLASSIFIER=false

# Local free chatbot (Ollama) — DeepSeek R1 on your laptop
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1:latest
OLLAMA_TIMEOUT_SECONDS=300
# Chat: Google News RSS + Yahoo Finance (MRF.NS, MARUTI.NS) before each reply
CHAT_LIVE_ENRICHMENT_ENABLED=true
CHAT_ENRICHMENT_TIMEOUT_SECONDS=12
CONFIG_DIR=config
DATA_DIR=data
